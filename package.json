{
  "name": "pkh-vkh-rechner",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "build:single": "node scripts/build-single-html.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json --local",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist --ignore-pattern single-dist --ignore-pattern release",
    "db:generate": "drizzle-kit generate",
    "audit:security": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "satori": {
      "fflate": "0.8.3"
    },
    "@shuding/opentype.js": {
      "fflate": "0.8.3"
    }
  }
}
